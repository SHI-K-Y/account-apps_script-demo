{
  "name": "bookkeeping-gas",
  "version": "10.0.0",
  "private": true,
  "description": "記帳簿（Google Apps Script + Google 試算表）— 公開原始碼與線上 Demo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:debug": "node tools/build.mjs --no-minify",
    "dev": "node tools/build.mjs --no-minify --watch --serve",
    "preview": "node tools/build.mjs && node tools/dev-server.mjs",
    "test": "node tools/build.mjs --no-minify --quiet && node tools/run-tests.mjs tools/test",
    "deploy": "node tools/build.mjs && npx @google/clasp push",
    "deploy:inline": "node tools/build.mjs --template inline && npx @google/clasp push",
    "preview:demo": "node tools/demo/build-demo.mjs && node tools/demo/serve.mjs",
    "perf": "node tools/build.mjs --quiet && node tools/perf/run.mjs",
    "build:demo": "node tools/demo/build-demo.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/web": "2.1.1",
    "esbuild": "^0.24.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0"
  }
}
